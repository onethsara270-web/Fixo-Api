<%- include('partials/head', { title: 'Sign in' }) %>
<%- include('partials/nav') %>

<section class="auth-page">
  <div class="auth-card glass reveal">
    <h1>Welcome back</h1>
    <p class="muted">Sign in to access your dashboard.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert error">Login failed. Check your credentials.</div>
    <% } %>

    <a href="/auth/google" class="btn btn-google">
      <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#fff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/></svg>
      Continue with Google
    </a>

    <div class="divider"><span>or</span></div>

    <form action="/auth/login" method="POST">
      <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/dashboard' %>">
      <label>Email
        <input type="email" name="email" required placeholder="you@example.com">
      </label>
      <label>Password
        <input type="password" name="password" required placeholder="••••••••">
      </label>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Sign in</button>
    </form>

    <p class="auth-alt">No account? <a href="/register">Create one</a></p>
  </div>
</section>

<%- include('partials/foot') %>